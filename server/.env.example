PORT=3001
HOST=0.0.0.0
DB_PATH=./data/barigo.sqlite
# Explicit local demo authentication. Must be false before production.
ENABLE_DEMO_AUTH=true
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Public OSRM service is for development only, no uptime/quota guarantee.
OSRM_URL=https://router.project-osrm.org
# Set a strong secret to enable admin configuration. No default exists.
ADMIN_SECRET=

# Photon público sólo desarrollo; autoalojar para operación real.
PHOTON_URL=https://photon.komoot.io/api/
